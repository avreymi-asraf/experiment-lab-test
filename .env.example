# Copy to .env (git-ignored) and fill in values. Never commit real values.
# In a cloud runtime, set the same names in that platform's secret store.
# `lab.py run` and `lab.py evaluate` load .env and also set LAB_ROOT (the lab root) and EXP_DIR (the experiment's lab folder, experiments/<exp-name>/).

# One line per variable the lab's experiments read, with a one-line purpose. Example:
# DATA_DIR=        # local clone of the data repo; commands use $DATA_DIR/<path from plan.md data_source>
COLAB_TOKEN_B64=   # Colab login for machines without a browser: base64 of the login JSON (`base64 -w0 colab-token.json`). Cloud: an environment variable; the environment's setup script installs a `colab` that reads it
HF_TOKEN=          # Hugging Face token, to download base models / push adapters (optional)
DATA_DIR=          # local copy of the (de-identified) documents; commands use $DATA_DIR/<path from plan.md data_source>
