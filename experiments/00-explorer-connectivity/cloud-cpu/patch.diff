+"""Synthetic stand-ins, so the guard and a smoke run work with no data repo access, no network and no credentials.
+
+`make_sample` writes a sample folder with the schema of the real one (four CSV tables plus manifest.json,
+same column names as `data.py` reads) filled with invented values: not a single value comes from a patient.
+`make_tiny_model` writes a randomly initialised ~1M-parameter causal LM and its tokenizer into a local folder;
+pass that folder as `RunConfig.model_id` to run `train()` without downloading anything.
+
+    uv run python -m explorer.synth --out $EXP_DIR/../../.synth    # sample + model under <out>/sample, <out>/model
+
+Standard library for the sample; the model needs the `train` extra.
+"""
+
+import argparse
+import csv
+import json
+import random
+from pathlib import Path
+
+from explorer.data import TABLE_NAMES
+
+CANCER_TYPES = ("Lung Cancer", "Colorectal Cancer", "Breast Cancer", "Prostate Cancer")
+SITES = ("Lung", "Liver", "Colon", "Lymph Node", "Bone")
+GENES = ("TP53", "KRAS", "EGFR", "PIK3CA", "APC", "BRAF", "PTEN", "ALK")
+EVENTS = ("Diagnosis", "Treatment", "Imaging", "Surgery")
+
+
+def make_sample(out_dir: str | Path, n_patients: int = 60, seed: int = 0) -> Path:
+    """Write a synthetic sample folder of `n_patients` patients; return its path. Deterministic in `seed`."""
+    rng = random.Random(seed)
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    patients, samples, events, mutations = [], [], [], []
+    for i in range(n_patients):
+        pid = f"SYN-P-{i:04d}"
+        patients.append({"patientId": pid, "SEX": rng.choice(["Female", "Male"]), "OS_STATUS": rng.choice(["0:LIVING", "1:DECEASED"]),
+                         "OS_MONTHS": f"{rng.uniform(1, 90):.1f}", "AGE_AT_DIAGNOSIS": str(rng.randint(30, 85))})
+        for j in range(rng.randint(1, 2)):
+            samples.append({"patientId": pid, "sampleId": f"SYN-S-{i:04d}-{j}", "CANCER_TYPE": rng.choice(CANCER_TYPES),
+                            "CANCER_TYPE_DETAILED": "Synthetic adenocarcinoma", "SAMPLE_TYPE": rng.choice(["Primary", "Metastasis"]),
+                            "PRIMARY_SITE": rng.choice(SITES), "METASTATIC_SITE": rng.choice(SITES + ("",)),
+                            "MSI_TYPE": rng.choice(["Stable", "Instable"]), "TMB_NONSYNONYMOUS": f"{rng.uniform(0, 30):.1f}",
+                            "GENE_PANEL": "SYN-PANEL"})
+        for _ in range(rng.randint(1, 4)):
+            events.append({"patientId": pid, "EVENT_TYPE": rng.choice(EVENTS), "START_DATE": str(rng.randint(0, 1500))})
+        for gene in rng.sample(GENES, rng.randint(0, 4)):
+            mutations.append({"patientId": pid, "gene": gene, "variant": "synthetic"})
+    tables = {"patients": patients, "samples": samples, "timeline_events": events, "mutations": mutations}
+    for name in TABLE_NAMES:
+        with (out / f"{name}.csv").open("w", newline="") as f:
+            writer = csv.DictWriter(f, fieldnames=list(tables[name][0].keys()))
+            writer.writeheader()
+            writer.writerows(tables[name])
+    manifest = {"study": "synthetic", "license": "synthetic data, no restrictions", "seed": seed,
+                "counts": {name: len(tables[name]) for name in TABLE_NAMES}, "fetched_utc": "n/a"}
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    return out
+
+
+def make_tiny_model(out_dir: str | Path, texts: list[str], vocab_size: int = 512) -> Path:
+    """Write a random-weight tiny GPT-2-style LM and a BPE tokenizer trained on `texts` to `out_dir`; return the path.
+
+    Use it as `RunConfig(model_id=str(path))`. The loss on such a model says the plumbing moves, nothing about quality.
+    """
+    from tokenizers import Tokenizer, models, pre_tokenizers, trainers
+    from transformers import GPT2Config, GPT2LMHeadModel, PreTrainedTokenizerFast
+
+    out = Path(out_dir)
+    out.mkdir(parents=True, exist_ok=True)
+    tok = Tokenizer(models.BPE(unk_token="<unk>"))
+    tok.pre_tokenizer = pre_tokenizers.ByteLevel(add_prefix_space=False)
+    tok.train_from_iterator(texts, trainers.BpeTrainer(vocab_size=vocab_size, special_tokens=["<unk>", "<pad>", "<eos>"],
+                                                       initial_alphabet=pre_tokenizers.ByteLevel.alphabet()))
+    fast = PreTrainedTokenizerFast(tokenizer_object=tok, unk_token="<unk>", pad_token="<pad>", eos_token="<eos>")
+    fast.save_pretrained(out)
+    config = GPT2Config(vocab_size=len(fast), n_positions=512, n_embd=128, n_layer=2, n_head=2,
+                        bos_token_id=fast.eos_token_id, eos_token_id=fast.eos_token_id)
+    GPT2LMHeadModel(config).save_pretrained(out)
+    return out
+
+
+def main() -> None:
+    from explorer.data import load_tables, render_records
+
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--out", required=True, help="Folder to write sample/ and model/ into")
+    parser.add_argument("--no-model", action="store_true", help="Sample only (no torch needed)")
+    args = parser.parse_args()
+    sample = make_sample(Path(args.out) / "sample")
+    print(json.dumps({"sample": str(sample)}))
+    if not args.no_model:
+        model = make_tiny_model(Path(args.out) / "model", [r.text for r in render_records(load_tables(sample))])
+        print(json.dumps({"sample": str(sample), "model": str(model)}))
+
+
+if __name__ == "__main__":
+    main()
