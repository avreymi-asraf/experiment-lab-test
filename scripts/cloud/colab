#!/usr/bin/env bash
# `colab` for machines without a browser (Claude Code cloud sessions, CI): the real Colab CLI, logged in
# from the COLAB_TOKEN_JSON environment variable. Installed on PATH by scripts/cloud/setup.sh.
#
# Why a file on PATH and not a shell function or a SessionStart hook: it reaches every caller the same way
# (the main agent, subagents, `subprocess.run(["colab", ...])` in target repos), and repo hooks do not run
# in sessions that have several repositories.
#
# With COLAB_TOKEN_JSON set: writes it to ~/.config/colab-cli/adc.json (mode 600, rewritten on every call so
# a replaced secret takes effect) and adds `--auth=adc`. Without it: plain `colab` (a laptop's own login).
# `colab ssh` gets `-i ~/.ssh/id_ed25519` (made on first use), because ssh looks for keys in the passwd
# home, which in containers may differ from $HOME. The token is never printed.
set -euo pipefail

real=/opt/colab-cli/bin/colab
venv_python=/opt/colab-cli/tool/google-colab-cli/bin/python
if [ ! -x "$real" ]; then   # installed some other way (e.g. `uv tool install` on a laptop)
  tool_dir="$(uv tool dir 2>/dev/null || true)/google-colab-cli"
  real="$tool_dir/bin/colab"; venv_python="$tool_dir/bin/python"
fi
[ -x "$real" ] || { echo "colab wrapper: Colab CLI not installed; run scripts/cloud/setup.sh" >&2; exit 127; }

args=("$@")
if [ -n "${COLAB_TOKEN_JSON:-}" ]; then
  cfg="${XDG_CONFIG_HOME:-$HOME/.config}/colab-cli"
  adc="$cfg/adc.json"
  (
    umask 077; mkdir -p "$cfg"
    # Validate and add "type": "authorized_user" (the CLI's own token JSON lacks it). Value never printed.
    "$venv_python" -I -c '
import json, os, sys
try:
    d = json.loads(os.environ["COLAB_TOKEN_JSON"])
except ValueError:
    sys.exit("colab wrapper: COLAB_TOKEN_JSON is not valid JSON (value not shown)")
missing = [k for k in ("refresh_token", "client_id", "client_secret") if not d.get(k)]
if missing:
    sys.exit(f"colab wrapper: COLAB_TOKEN_JSON lacks {missing}")
d.setdefault("type", "authorized_user")
json.dump(d, open(sys.argv[1], "w"))
' "$adc.tmp"
    mv "$adc.tmp" "$adc"
  )
  export GOOGLE_APPLICATION_CREDENTIALS="$adc"
  # Behind a TLS-inspecting proxy (Claude Code cloud): the kernel and ssh websockets read this, not SSL_CERT_FILE alone.
  [ -n "${SSL_CERT_FILE:-}" ] && export WEBSOCKET_CLIENT_CA_BUNDLE="${WEBSOCKET_CLIENT_CA_BUNDLE:-$SSL_CERT_FILE}"
  case " $* " in *" --auth"*) ;; *) args=(--auth=adc "${args[@]}") ;; esac
fi

# `colab ssh ...` without -i/--identity: pass our own key explicitly.
for i in "${!args[@]}"; do
  [ "${args[$i]}" = "--" ] && break
  if [ "${args[$i]}" = "ssh" ]; then
    case " $* " in *" -i "*|*" --identity"*) ;; *)
      key="$HOME/.ssh/id_ed25519"
      if [ ! -f "$key" ] && command -v ssh-keygen >/dev/null; then
        (umask 077; mkdir -p "$HOME/.ssh"; ssh-keygen -q -t ed25519 -N '' -C colab-cli -f "$key")
      fi
      [ -f "$key" ] && args=("${args[@]:0:$((i+1))}" -i "$key" "${args[@]:$((i+1))}")
    esac
    break
  fi
done

exec "$real" "${args[@]}"
